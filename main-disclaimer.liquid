{{ 'disclaimer.css' | asset_url | stylesheet_tag }}

<section class="page-hero">
  <span class="hero-eyebrow reveal">Terms and Policies</span>
  <h1 class="page-hero-title reveal d1">Disclaimer</h1>
</section>

<section class="policy-body">
  <div class="container c-policy">
    <div class="policy-block reveal">
      <p class="policy-block-body">The information provided on getbonnd.com is for general informational and educational purposes only.</p>
    </div>
    <div class="policy-block reveal">
      <p class="policy-block-body">Bonnd products are not intended to diagnose, treat, cure, or prevent any disease. Individual results may vary.</p>
    </div>
    <div class="policy-block reveal">
      <p class="policy-block-body">Always consult a qualified healthcare professional before starting any dietary supplement, especially if you have a medical condition, are taking medication, or have health concerns.</p>
    </div>
  </div>
</section>

<script>
(function(){
  'use strict';
  const els=document.querySelectorAll('.reveal');
  if('IntersectionObserver' in window){
    const io=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:0.08,rootMargin:'0px 0px -30px 0px'});
    els.forEach(el=>io.observe(el));
  }else{els.forEach(el=>el.classList.add('in'));}
})();
</script>

{% schema %}
{
  "name": "Disclaimer",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "Disclaimer"
    }
  ]
}
{% endschema %}