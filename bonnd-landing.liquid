<style>
  /* ── 1. GLOBAL LAYOUT CONTROLS ── */
  #shopify-section-sections--header, 
  #shopify-section-sections--footer,
  .shopify-section-group-header-group,
  .shopify-section-group-footer-group { 
    display: none !important; 
  }

  /* ── 2. GLOBAL REVEAL SYSTEM ── */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s ease, transform 0.8s ease;
    will-change: transform, opacity;
  }

  .reveal.in {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── 3. PREMIUM HERO ANIMATION ── */
  /* Added scale and longer duration for a smoother "wake up" feel */
  .hero-text, .hero-sub, .hero-cta {
    transform: translateY(30px) scale(0.98);
    transition: opacity 1.2s cubic-bezier(0.2, 1, 0.3, 1), 
                transform 1.2s cubic-bezier(0.2, 1, 0.3, 1) !important;
  }

  /* The Staggered Wave for the Hero */
  .hero-text.in { transition-delay: 0.2s !important; }
  .hero-sub.in  { transition-delay: 0.4s !important; }
  .hero-cta.in  { transition-delay: 0.6s !important; }

  /* ── 4. STAGGER LOGIC (Lists) ── */
  .stagger-list li {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .reveal.in .stagger-list li { opacity: 1; transform: translateY(0); }
  .reveal.in .stagger-list li:nth-child(1) { transition-delay: 0.1s; }
  .reveal.in .stagger-list li:nth-child(2) { transition-delay: 0.2s; }
  .reveal.in .stagger-list li:nth-child(3) { transition-delay: 0.3s; }
  .reveal.in .stagger-list li:nth-child(4) { transition-delay: 0.4s; }
  .reveal.in .stagger-list li:nth-child(5) { transition-delay: 0.5s; }

  /* ── 5. MOBILE CORRECTIONS (Danny's Final) ── */
  @media (max-width: 768px) {
    .hero { 
      padding: 80px 20px 50px !important; 
      min-height: auto !important; 
    }
    section { padding: 50px 20px !important; }

    .email-row, .close-email-row { flex-direction: column; }
    .email-row input, .close-email-row input { border-right: 1px solid #333; }
    .btn-submit, .close-email-row .btn-submit { width: 100%; padding: 16px; }
    .qualify-grid { grid-template-columns: 1fr; }

    /* Font Sizes */
    body, .get-list li, .q-col ul li { font-size: 13px !important; }
    .hero h1 { font-size: 25px !important; line-height: 1.2; }
    .hero .sub { font-size: 14px !important; }
    .mech-sec h2, .get-sec h2, .qualify-sec h2 { font-size: 22px !important; }
    .mirror-sec .intro, .signal-list li, .mech-sec p, .callout { font-size: 15px !important; }
    .close-quote { font-size: 20px !important; }
    .mirror-close, .cta-timer { font-size: 15px !important; }
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in');
      }
    });
  }, { threshold: 0.05 });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>

