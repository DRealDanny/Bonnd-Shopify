{{ 'privacy-policy.css' | asset_url | stylesheet_tag }}

<section class="page-hero">
  <span class="hero-eyebrow reveal">Terms and Policies</span>
  <h1 class="page-hero-title reveal d1">Privacy Policy</h1>
</section>

<section class="policy-body">
  <div class="container c-policy">

    <p class="policy-lead reveal">Your privacy matters to us.</p>

    <div class="policy-block reveal d1">
      <p class="policy-block-body">This Privacy Policy explains how Bonnd ("we," "us," or "our") collects, uses, and protects your personal information when you visit or make a purchase from getbonnd.com.</p>
    </div>

    <div class="policy-block reveal">
      <p class="policy-block-title">What information we collect</p>
      <p class="policy-block-body">When you visit our site or place an order, we may collect personal information such as your name, email address, shipping address, and payment details, as well as order and transaction information and basic device and browsing information for site functionality and analytics. We collect only what's necessary to operate the site and fulfill orders.</p>
    </div>

    <div class="policy-block reveal">
      <p class="policy-block-title">How we use your information</p>
      <p class="policy-block-body">We use your information to process and fulfill orders, communicate with you about your purchase or subscription, provide customer support, improve site performance and customer experience, and comply with legal obligations. We do not sell your personal information.</p>
    </div>

    <div class="policy-block reveal">
      <p class="policy-block-title">Third-party services</p>
      <p class="policy-block-body">We use trusted third-party services such as Shopify and payment processors to operate our store and process payments. These services have their own privacy policies governing how they handle your information.</p>
    </div>

    <div class="policy-block reveal">
      <p class="policy-block-title">Data security</p>
      <p class="policy-block-body">We take reasonable steps to protect your information using industry-standard security measures. No online system is completely risk-free, but we aim to handle your data responsibly.</p>
    </div>

    <div class="policy-block reveal">
      <p class="policy-block-title">Your rights</p>
      <p class="policy-block-body">Depending on your location, you may have the right to access your personal data, request corrections or deletion, or opt out of certain communications. You can contact us at <a href="mailto:support@getbonnd.com">support@getbonnd.com</a> for privacy-related requests.</p>
    </div>

    <div class="policy-block reveal">
      <p class="policy-block-title">Changes to this policy</p>
      <p class="policy-block-body">We may update this Privacy Policy as needed. Any changes will be posted on this page.</p>
    </div>

  </div>
</section>

<script>
(function(){
  'use strict';
  const els=document.querySelectorAll('.reveal');
  if('IntersectionObserver' in window){
    const io=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:0.08,rootMargin:'0px 0px -30px 0px'});
    els.forEach(el=>io.observe(el));
  }else{els.forEach(el=>el.classList.add('in'));}
})();
</script>

{% schema %}
{
  "name": "Privacy Policy",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "Privacy Policy"
    }
  ]
}
{% endschema %}