<script>
document.addEventListener('DOMContentLoaded', () => {
  const mt = document.querySelector('.marquee-track');
  if(mt) {
    const mw = mt.closest('.marquee-wrap');
    mw.addEventListener('mouseenter', () => mt.style.animationPlayState='paused');
    mw.addEventListener('mouseleave', () => mt.style.animationPlayState='running');
  }

  const els = document.querySelectorAll('.reveal');
  if('IntersectionObserver' in window) {
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if(e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -36px 0px' });
    els.forEach(el => io.observe(el));
  } else {
    els.forEach(el => el.classList.add('in'));
  }
});
</script>

