<div class="sb-overlay" id="sbOverlay"></div>
<aside class="sidebar" id="sidebar">
  <div class="sb-head">
    <span class="sb-logo">
      <img src="{{ 'bonnd-logo.png' | file_url }}" alt="Bonnd" class="brand-logo" />
    </span>
    <button class="sb-close" id="sbClose" aria-label="Close"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
  </div>
  
 <nav class="sb-nav">
    <a href="{{ routes.root_url }}" class="sb-link {% if request.path == '/' %}active{% endif %}">Home</a>
    <a href="/pages/product" class="sb-link {% if request.path contains 'product' %}active{% endif %}">Product</a>
    <a href="/pages/about" class="sb-link {% if request.path contains 'about' %}active{% endif %}">About Us</a>
    <a href="/pages/faq" class="sb-link {% if request.path contains 'faq' %}active{% endif %}">FAQ</a>
    <a href="/pages/contact" class="sb-link {% if request.path contains 'contact' %}active{% endif %}">Contact</a>
  </nav>
  
  <div class="sb-foot">
    <div class="sb-icons">
      <a href="{{ routes.search_url }}" class="sb-icon" aria-label="Search"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg></a>
      <a href="{{ routes.account_url }}" class="sb-icon" aria-label="Account"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></a>
      <a href="{{ routes.cart_url }}" class="sb-icon" aria-label="Cart"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></a>
    </div>
  </div>
